# Volvo hackathon - team environment (TEMPLATE).
# Your coach gives you a filled-in copy. Save it as `.env` next to verify-lab.ps1.
# Keep the real file private - it holds keys and is gitignored.

# --- Foundry (Azure OpenAI-compatible) ---
AZURE_OPENAI_ENDPOINT=https://<your-foundry>.cognitiveservices.azure.com
AZURE_OPENAI_KEY=<key>
AZURE_OPENAI_API_VERSION=2025-01-01-preview
CHAT_DEPLOYMENT=gpt-5.6-luna
EMBEDDING_DEPLOYMENT=text-embedding-3-large

# --- Azure AI Search ---
SEARCH_ENDPOINT=https://<your-search>.search.windows.net
SEARCH_KEY=<key>
SEARCH_INDEX=hackdata-index

# --- Cosmos DB (NoSQL) ---
COSMOS_ENDPOINT=https://<your-cosmos>.documents.azure.com:443/
COSMOS_KEY=<key>
COSMOS_DATABASE=truckoffer

# --- Blob storage (hack data set) ---
STORAGE_ACCOUNT=<your-storage-account>
STORAGE_CONTAINER=hackdata
STORAGE_CONNECTION_STRING=<connection-string>
STORAGE_SAS=<container-sas-token>

# --- Container registry (optional: push your own app image) ---
ACR_LOGIN_SERVER=<your-registry>.azurecr.io
ACR_USERNAME=<username>
ACR_PASSWORD=<password>
